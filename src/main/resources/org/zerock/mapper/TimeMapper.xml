<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 인터페이스와 매핑되는 필수 코드 -->    
<!-- 참고사이트: (공식) https://mybatis.org/mybatis-3/ko/sqlmap-xml.html#select -->

<mapper namespace="org.zerock.mapper.TimeMapper"><!-- 인터페이스명 -->

	<select id="getTime2" resultType="string">
	<!-- id: 메서드명		/	resultType: 문자열  -->
		SELECT sysdate From dual
	</select>

</mapper>